# Wayfare local configuration. Copy to `.env` (which is gitignored).
# No external API credentials are required. See "REQUIRED APIS.md".

# --- Database (matches docker-compose.yml; non-secret local dev defaults) ---
DATABASE_URL=postgres://wayfare:wayfare_dev@localhost:54329/wayfare
TEST_DATABASE_URL=postgres://wayfare:wayfare_dev@localhost:54329/wayfare_test

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Seed ---
# Anchor date (YYYY-MM-DD) for synthetic availability. Leave empty for "today" in SAST.
SEED_REFERENCE_DATE=

# --- Web (Vite) ---
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
